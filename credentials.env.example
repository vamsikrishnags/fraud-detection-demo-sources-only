# Copied to credentials.env (gitignored) by `uv run deploy`, which prompts for
# anything missing and saves it here. Never commit credentials.env.

# Confluent Cloud API key + secret.
#  - New environment: an org-level "Cloud resource management" key.
#  - Existing environment: a key whose principal has EnvironmentAdmin on it.
TF_VAR_confluent_cloud_api_key=
TF_VAR_confluent_cloud_api_secret=

# Optional: use an EXISTING environment instead of creating one.
# Both must be set together; leave blank to create a new environment.
DATAGEN_ENVIRONMENT_ID=          # env-xxxxx
DATAGEN_SERVICE_ACCOUNT_ID=      # sa-xxxxx (owns the generated Kafka/SR/Flink keys; normally the key's own service account)
